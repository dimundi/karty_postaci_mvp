# Pliki tekstowe zapisujemy w repozytorium z końcami linii LF.
* text=auto eol=lf

# Skrypty Windows wymagają CRLF w katalogu roboczym.
*.bat text eol=crlf
*.cmd text eol=crlf

# Grafiki wektorowe i konfiguracje pozostają tekstowe.
*.svg text eol=lf
*.json text eol=lf
*.md text eol=lf

# Pliki binarne: bez zmiany końców linii i tekstowego diff/merge.
*.pdf binary
*.ai binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
